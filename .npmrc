# パッケージの取得先
# 共有プロジェクトを作った後は、Artifact Registry の npm リモートリポジトリへ切り替える（docs/platform_design.md §7.2）
#   registry=https://<region>-npm.pkg.dev/<project-id>/npm-remote/
#   //<region>-npm.pkg.dev/<project-id>/npm-remote/:_authToken=${NPM_AR_TOKEN}
# NPM_AR_TOKEN は `gcloud auth print-access-token` で取得する（ファイルにトークンを書かない）
registry=https://registry.npmjs.org/
engine-strict=true
