# platform/terraform/terraform.tfvars（Git 管理外）に書く、任意の設定。
# プロジェクト ID などの基本の値は platform/config.json で決めるので、このファイルはなくても動く。

# Google ログイン用 OAuth クライアント（コンソールで作成。空なら Firebase コンソールで Google プロバイダを有効化する）
# CI から apply するなら、同じ値をリポジトリのシークレット GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET にも登録する
# google_oauth_client_id     = "xxxx.apps.googleusercontent.com"
# google_oauth_client_secret = "xxxx"

# 予算アラートを作る課金アカウント（空なら、プロジェクトに紐付いている課金アカウントを使う）
#   予算アラート・監査アラートを作るかどうか・金額・通知先は platform/config.json で決める
# billing_account = "XXXXXX-XXXXXX-XXXXXX"
